  <content>
    <procedure>
      <commonInfo>
        <title>Job description</title>
        <para>This procedure gives the information to remove damaged screws.</para>
      </commonInfo>
      <preliminaryRqmts>
        <reqCondGroup>
          <noConds />
        </reqCondGroup>
        <reqSupportEquips>
          <supportEquipDescrGroup>
            <supportEquipDescr>
              <name>Standard Mechanician Tools</name>
              <toolRef manufacturerCodeValue="Commercially available" toolNumber="No specific" />
              <reqQuantity unitOfMeasure="As Required" />
            </supportEquipDescr>
          </supportEquipDescrGroup>
        </reqSupportEquips>
        <reqSupplies>
          <noSupplies />
        </reqSupplies>
        <reqSpares>
          <noSpares />
        </reqSpares>
        <reqSafety>
          <safetyRqmts>
            <note>
              <notePara>Only approved personnel must do the maintenance to the component.</notePara>
            </note>
          </safetyRqmts>
        </reqSafety>
      </preliminaryRqmts>
      <?pb ?>
      <mainProcedure>
        <proceduralStep>
          <title>Procedure</title>
          <para>Refer to <internalRef internalRefId="B7772S11MONA25301201004663AC_fig-16" /> Damaged Screw Removal.</para>
          <note>
            <notePara>Examples of damaged screws are shown in sheet 1.</notePara>
          </note>
          <proceduralStep>
            <para>Remove the damaged head by drilling or milling or filling it.</para>
          </proceduralStep>
          <proceduralStep>
            <para>Drill a hole into the remaining screw (sheet 2).</para>
            <note>
              <notePara>Drill with a drill bit having a diameter smaller than the thread diameter.</notePara>
            </note>
          </proceduralStep>
          <proceduralStep>
            <para>Mount a screw extractor fitted on an screwing machine.</para>
          </proceduralStep>
          <proceduralStep>
            <para>Set the screwing machine to a slow speed and high torque.</para>
            <note>
              <notePara>Refer to the screw extractor instructions for speed and torque value if indicated.</notePara>
            </note>
          </proceduralStep>
          <proceduralStep>
            <para>Screw slowly the extractor into the screw while applying pressure to extract it (sheets 3 and 4).</para>
            <note>
              <notePara>The extractor is turned counter-clockwise to screw it.</notePara>
            </note>
          </proceduralStep>
          <proceduralStep>
            <para>If the extractor do not extract the screw, go back from step 1.2 and drill a hole one size bigger.</para>
          </proceduralStep>
          <proceduralStep>
            <para>Clean the part and remove any particle of screw.</para>
          </proceduralStep>
          <proceduralStep>
            <para>Examine the thread of the part to make sure it is not damaged before a new screw is installed.</para>
            <?pb ?>
            <figure id="B7772S11MONA25301201004663AC_fig-16">
              <title>Damaged Screw Removal</title>
              <graphic id="B7772S11MONA25301201004663AC_fig-16-gra-001" infoEntityIdent="ICN-B7772S11MON-A-253012-A-F0465-60003-A-001-01" />
              <graphic id="B7772S11MONA25301201004663AC_fig-16-gra-002" infoEntityIdent="ICN-B7772S11MON-A-253012-A-F0465-60004-A-001-01" />
              <graphic id="B7772S11MONA25301201004663AC_fig-16-gra-003" infoEntityIdent="ICN-B7772S11MON-A-253012-A-F0465-60005-A-001-01" />
              <graphic id="B7772S11MONA25301201004663AC_fig-16-gra-004" infoEntityIdent="ICN-B7772S11MON-A-253012-A-F0465-60006-A-001-01" />
            </figure>
          </proceduralStep>
        </proceduralStep>
      </mainProcedure>
