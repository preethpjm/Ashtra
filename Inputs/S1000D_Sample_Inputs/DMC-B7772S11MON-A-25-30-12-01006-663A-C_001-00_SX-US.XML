  <content>
    <procedure>
      <commonInfo>
        <title>Job description</title>
        <para>This procedure gives the information regarding the securing
of the self fasteners.</para>
      </commonInfo>
      <preliminaryRqmts>
        <reqCondGroup>
          <noConds />
        </reqCondGroup>
        <reqSupportEquips>
          <supportEquipDescrGroup>
            <supportEquipDescr>
              <name>Standard Mechanician Tools</name>
              <toolRef manufacturerCodeValue="Commercially available" toolNumber="No specific" />
              <reqQuantity unitOfMeasure="AR" />
            </supportEquipDescr>
          </supportEquipDescrGroup>
        </reqSupportEquips>
        <reqSupplies>
          <noSupplies />
        </reqSupplies>
        <reqSpares>
          <noSpares />
        </reqSpares>
        <reqSafety>
          <safetyRqmts>
            <note>
              <notePara>Only approved personnel must do the maintenance to the component.</notePara>
            </note>
          </safetyRqmts>
        </reqSafety>
      </preliminaryRqmts>
      <?pb?>
      <mainProcedure>
        <proceduralStep>
          <title>Procedure</title>
          <proceduralStep>
            <title>Securing self fasteners procedure</title>
            <para>Refer to <internalRef internalRefId="B7772S11MONA25301201006663AC_fig-09" /> Self-fasteners Securing</para>
            <proceduralStep>
              <para>To improve adhesion on non-metallic surface, if possible, sand the area where the self-fastener will be installed. Mask as necessary.</para>
            </proceduralStep>
            <proceduralStep>
              <para>Clean the surfaces with applicable solvent (acetone
on metals, isopropyl alcohol on non metallics), with a clean cloth.</para>
            </proceduralStep>
            <proceduralStep>
              <para>Remove the protective tape from the adhesive
side of the self fastener. Apply gradually, smoothing down from one
end to the other to prevent wrinkles or trapped air. When handling,
prevent touching the adhesive side (otherwise degrade the adhesive
properties of the self fastener).</para>
            </proceduralStep>
            <proceduralStep>
              <para>The self-fasteners must be secured with adhesive (SW 3532 B/A) on edges as shown in the <internalRef internalRefId="B7772S11MONA25301201006663AC_fig-09" />. 
</para>
            </proceduralStep>
            <proceduralStep>
              <para>The adhesive must cover approximately 5 mm (0.20
in) on either side of the edge of the self fastener.</para>
              <note>
                <notePara>The full polymerization is done after 24h at 24&deg;C (75.2&deg;F).</notePara>
              </note>
              <figure id="B7772S11MONA25301201006663AC_fig-09">
                <title>Self-fasteners Securing</title>
                <graphic id="B7772S11MONA25301201006663AC_fig-09-gra-001" infoEntityIdent="ICN-B7772S11MON-A-253012-A-F0465-60007-A-001-01" />
              </figure>
            </proceduralStep>
          </proceduralStep>
        </proceduralStep>
      </mainProcedure>
      <closeRqmts>
        <reqCondGroup>
          <noConds />
        </reqCondGroup>
      </closeRqmts>
    </procedure>
