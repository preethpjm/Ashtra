<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
	<xs:element name="cmm">
		<xs:complexType>
			<xs:choice>
				<xs:sequence>
          <xs:element ref="applic" minOccurs="0"/>
          <xs:element ref="inlineapplics" minOccurs="0"/>
					<xs:element ref="title"/>
					<xs:element ref="partinfo" maxOccurs="unbounded"/>
					<xs:element ref="legalntc" minOccurs="0"/>
					<xs:element ref="ror" minOccurs="0"/>
					<xs:element ref="mfmatr"/>
					<xs:element ref="pgblk" maxOccurs="unbounded"/>
					<xs:element ref="ipl"/>
				</xs:sequence>
				<xs:element ref="increv"/>
				<xs:element ref="tr" maxOccurs="unbounded"/>
			</xs:choice>
			<xs:attribute name="spl" use="required" type="xs:anySimpleType"/>
			<xs:attribute name="oidate" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="tsn" use="required" type="xs:anySimpleType"/>
			<xs:attribute name="docnbr" type="xs:anySimpleType"/>
			<xs:attribute name="lang" use="required" type="xs:anySimpleType"/>
			<xs:attribute name="chapnbr" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="sectnbr" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="subjnbr" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="type" default="cmm">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="cmm"/>
						<xs:enumeration value="acmm"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="prelim" default="0" type="xs:NMTOKEN"/>
			<xs:attribute name="chg" default="n">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="n"/>
						<xs:enumeration value="r"/>
						<xs:enumeration value="s"/>
						<xs:enumeration value="u"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="revdate" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="efflen" type="xs:NMTOKEN"/>
			<xs:attribute name="efftype" type="xs:anySimpleType"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="increv">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="applic" minOccurs="0"/>
				<xs:element ref="inlineapplics" minOccurs="0"/>
				<xs:element ref="legalntc" minOccurs="0"/>
				<xs:choice maxOccurs="unbounded">
					<xs:element ref="pgblk"/>
					<xs:element ref="ipl"/>
					<xs:element ref="task"/>
					<xs:element ref="subtask"/>
					<xs:element ref="transltr"/>
					<xs:element ref="sblist"/>
					<xs:element ref="sheet"/>
					<xs:element ref="graphic"/>
					<xs:element ref="figure"/>
					<xs:element ref="prtlist"/>
					<xs:element ref="hazmtlst"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="tr">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="applic" minOccurs="0"/>
				<xs:element ref="inlineapplics" minOccurs="0"/>
				<xs:element ref="legalntc" minOccurs="0"/>
				<xs:element ref="trfmatr"/>
				<xs:choice>
					<xs:element ref="legalntc"/>
					<xs:element ref="pgblk" maxOccurs="unbounded"/>
					<xs:element ref="task" maxOccurs="unbounded"/>
					<xs:element ref="sheet" maxOccurs="unbounded"/>
					<xs:element ref="graphic" maxOccurs="unbounded"/>
					<xs:element ref="sblist"/>
					<xs:element ref="figure"/>
					<xs:element ref="prtlist"/>
					<xs:element ref="hazmtlst"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="trfmatr">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title"/>
				<xs:choice>
					<xs:choice maxOccurs="unbounded">
						<xs:element ref="para"/>
						<xs:element ref="table"/>
						<xs:element ref="unlist"/>
						<xs:element ref="numlist"/>
						<xs:element ref="note"/>
						<xs:element ref="deflist"/>
					</xs:choice>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="trnbr" use="required" type="xs:anySimpleType"/>
			<xs:attribute name="issdate" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="trdel" type="xs:anySimpleType"/>
			<xs:attribute name="trrepl" type="xs:anySimpleType"/>
		</xs:complexType>
	</xs:element>
		<xs:element name="ror">
				<xs:complexType>
		<xs:sequence>
		  <xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
				<xs:element ref="revitem"/>	
			</xs:choice>
        </xs:sequence>
			<xs:attribute name="chg" default="n">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="n"/>
						<xs:enumeration value="r"/>
						<xs:enumeration value="s"/>
						<xs:enumeration value="u"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>		

		<xs:attribute name="key" use="required" type="xs:ID"/>
	    <xs:attribute name="revdate" use="required" type="xs:NMTOKEN"/>
        <xs:attribute name="refapplic" type="xs:IDREF"/>
		</xs:complexType>
	</xs:element>
		<xs:element name="revitem">
		<xs:complexType>
		<xs:sequence>
		    <xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
			<xs:sequence>
				<xs:element ref="revno"/>
				<xs:element ref="revdate"/>
				<xs:element ref="revby" minOccurs="0"/>
				</xs:sequence>
				<xs:element ref="revend" minOccurs="0"/>
			</xs:sequence>		
		</xs:complexType>
	</xs:element>
	<xs:element name="revno" type="xs:string">
  </xs:element>
  <xs:element name="revdate" type="xs:string">
  </xs:element>
  <xs:element name="revby" type="xs:string">
  </xs:element>
	<xs:element name="legalntc">
		<xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element ref="applic" minOccurs="0"/>
        <xs:element ref="inlineapplics" minOccurs="0"/>
        <xs:element ref="exprtcl"/>
				<xs:element ref="cpyrght"/>
				<xs:element ref="proptary"/>
				<xs:element ref="geninfo"/>
			</xs:choice>
			<xs:attribute name="chg" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="n"/>
						<xs:enumeration value="d"/>
						<xs:enumeration value="r"/>
						<xs:enumeration value="u"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="key" use="required" type="xs:ID"/>
			<xs:attribute name="revdate" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="refapplic" type="xs:IDREF"/>
    </xs:complexType>
	</xs:element>
	<xs:element name="proptary">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="fullstmt"/>
				<xs:element ref="partstmt" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="fullstmt">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title" minOccurs="0"/>
				<xs:element ref="cpyrght" minOccurs="0"/>
				<xs:element ref="para" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="partstmt">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title" minOccurs="0"/>
				<xs:element ref="para" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="exprtcl">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element ref="para"/>
				<xs:element ref="unlist"/>
				<xs:element ref="numlist"/>
				<xs:element ref="note"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="cpyrght">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="year" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="holder" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="geninfo"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="year">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="holder">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="geninfo">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element ref="para"/>
				<xs:element ref="unlist"/>
				<xs:element ref="numlist"/>
				<xs:element ref="note"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="partinfo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title" minOccurs="0"/>
				<xs:sequence maxOccurs="unbounded">
					<xs:element ref="cmpnom" minOccurs="0"/>
					<xs:element ref="mfrpnr"/>
				</xs:sequence>
			</xs:sequence>
			<xs:attribute name="model" type="xs:anySimpleType"/>
      <xs:attribute name="refapplic" type="xs:IDREF"/>
    </xs:complexType>
	</xs:element>
	<xs:element name="cmpnom">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
				<xs:element ref="sub"/>
				<xs:element ref="super"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="mfrpnr">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pnr"/>
				<xs:element ref="mfr"/>
				<xs:element ref="altpnr" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="pnr">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="mfr">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="altpnr">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pnr"/>
				<xs:element ref="mfr"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="mfmatr">
		<xs:complexType>
			<xs:sequence>
        <xs:element ref="applic" minOccurs="0"/>
        <xs:element ref="inlineapplics" minOccurs="0"/>
        <xs:element ref="transltr" minOccurs="0"/>
				<xs:element ref="trlist" minOccurs="0"/>
				<xs:element ref="sblist"/>
				<xs:element ref="hazmtlst" minOccurs="0"/>
			</xs:sequence>
      <xs:attribute name="refapplic" type="xs:IDREF"/>
    </xs:complexType>
	</xs:element>
	<xs:element name="transltr">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="chgdesc" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="title"/>
				<xs:choice>
					<xs:element ref="prclist1"/>
					<xs:choice maxOccurs="unbounded">
						<xs:element ref="para"/>
						<xs:element ref="table"/>
						<xs:element ref="unlist"/>
						<xs:element ref="numlist"/>
						<xs:element ref="note"/>
						<xs:element ref="deflist"/>
					</xs:choice>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="trlist">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title"/>
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:choice maxOccurs="unbounded">
						<xs:element ref="para"/>
						<xs:element ref="table"/>
						<xs:element ref="unlist"/>
						<xs:element ref="numlist"/>
						<xs:element ref="note"/>
						<xs:element ref="deflist"/>
					</xs:choice>
				</xs:choice>
				<xs:choice>
					<xs:element ref="trdata" maxOccurs="unbounded"/>
					<xs:element ref="isempty"/>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="chg" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="n"/>
						<xs:enumeration value="d"/>
						<xs:enumeration value="r"/>
						<xs:enumeration value="u"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="key" use="required" type="xs:ID"/>
			<xs:attribute name="revdate" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="refapplic" type="xs:IDREF"/>
    </xs:complexType>
	</xs:element>
	<xs:element name="trdata">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="trnbr"/>
				<xs:element ref="trstatus"/>
				<xs:element ref="trloc" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="trnbr">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="trstatus">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="trloc">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="sblist">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="chgdesc" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="title"/>
				<xs:choice minOccurs="0">
					<xs:choice maxOccurs="unbounded">
						<xs:element ref="para"/>
						<xs:element ref="table"/>
						<xs:element ref="unlist"/>
						<xs:element ref="numlist"/>
						<xs:element ref="note"/>
						<xs:element ref="deflist"/>
					</xs:choice>
				</xs:choice>
				<xs:choice>
					<xs:element ref="sbdata" maxOccurs="unbounded"/>
					<xs:element ref="isempty"/>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="chg" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="n"/>
						<xs:enumeration value="d"/>
						<xs:enumeration value="r"/>
						<xs:enumeration value="u"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="key" use="required" type="xs:ID"/>
			<xs:attribute name="revdate" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="refapplic" type="xs:IDREF"/>
    </xs:complexType>
	</xs:element>
	<xs:element name="sbdata">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="effect" minOccurs="0"/>
				<xs:element ref="sbnbr"/>
				<xs:element ref="sbtitle" minOccurs="0"/>
				<xs:element ref="mdnbr" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="issdate" minOccurs="0"/>
				<xs:element ref="sbrev" minOccurs="0"/>
				<xs:element ref="ics" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="sbnbr">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="sbtitle">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="mdnbr">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="issdate">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="sbrev">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="ics">
		<xs:complexType mixed="true">
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="revst"/>
				<xs:element ref="revend"/>
				<xs:element ref="hotlink"/>
				<xs:element ref="effect"/>
			</xs:choice>
			<xs:attribute name="status" type="xs:anySimpleType"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="hazmtlst">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title"/>
				<xs:element ref="pretopic" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="hazmt" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="chg" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="n"/>
						<xs:enumeration value="d"/>
						<xs:enumeration value="r"/>
						<xs:enumeration value="u"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="key" use="required" type="xs:ID"/>
			<xs:attribute name="revdate" use="required" type="xs:NMTOKEN"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="hazmt">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title"/>
				<xs:element ref="warning"/>
			</xs:sequence>
			<xs:attribute name="id" use="required" type="xs:ID"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="pretopic">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="title"/>
				<xs:choice>
					<xs:choice maxOccurs="unbounded">
						<xs:element ref="para"/>
						<xs:element ref="table"/>
						<xs:element ref="unlist"/>
						<xs:element ref="numlist"/>
						<xs:element ref="note"/>
						<xs:element ref="deflist"/>
					</xs:choice>
					<xs:element ref="list1"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="pgblk">
		<xs:complexType>
			<xs:choice>
				<xs:sequence>
					<xs:element ref="effect" minOccurs="0"/>
					<xs:element ref="chgdesc" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element ref="title"/>
					<xs:element ref="task" maxOccurs="unbounded"/>
				</xs:sequence>
				<xs:choice>
					<xs:sequence>
						<xs:element ref="deleted"/>
						<xs:element ref="chgdesc" minOccurs="0"/>
					</xs:sequence>
					<xs:element ref="isempty"/>
				</xs:choice>
			</xs:choice>
			<xs:attribute name="chappref" type="xs:anySimpleType"/>
			<xs:attribute name="chapnbr" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="sectnbr" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="subjnbr" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="pgblknbr" use="required" type="xs:NMTOKEN"/>
			<xs:attribute name="confnbr" type="xs:NMTOKEN"/>
			<xs:attribute name="chg" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="n"/>
						<xs:enumeration value="d"/>
						<xs:enumeration value="r"/>
						<xs:enumeration value="u"/>
