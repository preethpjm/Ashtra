<prcitem1><prcitem>
<para>Consumables</para>
<note><para>See consumables table <refint reftype="1"
refid="PGBLK-25-15-65-6001-">(refer to Page Block 6001) &ldquo;REPAIR&rdquo;
</refint>.</para>
</note>
</prcitem></prcitem1>
