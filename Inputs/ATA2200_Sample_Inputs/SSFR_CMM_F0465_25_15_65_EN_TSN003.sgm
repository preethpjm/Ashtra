<row>
<entry align="left">
<para>P/N</para>
</entry>
<entry align="left">
<para>Weight (lb)</para>
</entry>
<entry align="left">
<para>Weight (kg)</para>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
