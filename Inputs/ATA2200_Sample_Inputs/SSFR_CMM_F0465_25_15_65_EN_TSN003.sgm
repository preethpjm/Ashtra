<?Pub _newpage>
<prcitem1><prcitem>
<para>New codification information</para>
</prcitem>
<prclist2>
<prcitem2><prcitem>
<para>We modified our references to be in accordance with standard.</para>
<note><para>Old and new part numbers are two ways interchangeable.</para>
</note>
</prcitem></prcitem2>
<prcitem2><prcitem>
<para>On a general basis :</para>
</prcitem>
<prclist3>
<prcitem3><prcitem>
<para>all screws P/N NAS60X-X are replaced by P/N NAS60X-XP</para>
</prcitem></prcitem3>
<prcitem3><prcitem>
<para>all screws P/N NAS60X-X are replaced by P/N NAS60XXP</para>
</prcitem></prcitem3>
</prclist3>
</prcitem2>
</prclist2>
</prcitem1>
