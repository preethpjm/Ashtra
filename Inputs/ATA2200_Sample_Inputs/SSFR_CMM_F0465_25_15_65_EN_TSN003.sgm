</refint></para>
<para><refint reftype="1" refid="GRAPHIC-25-15-65-991-708-A01">Figure 7008
</refint></para>
<para><refint reftype="1" refid="GRAPHIC-25-15-65-991-709-A01">Figure 7009
</refint></para>
<para><refint reftype="1" refid="GRAPHIC-25-15-65-991-710-A01">Figure 7010
</refint></para>
<para><refint reftype="1" refid="GRAPHIC-25-15-65-991-711-A01">Figure 7011
</refint></para>
<para><refint reftype="1" refid="GRAPHIC-25-15-65-950-804-A01">Figure 4</refint></para>
</entry>
