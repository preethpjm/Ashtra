<para>Designation</para>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<para>No specific</para>
</entry>
<entry align="left">
<para>1</para>
</entry>
<entry>
<para>Standard mechanics technician's tool.</para>
</entry>
</row>
