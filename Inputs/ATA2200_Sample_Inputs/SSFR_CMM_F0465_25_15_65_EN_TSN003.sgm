</graphic></prcitem1>
<?Pub _newpage>
<prcitem1><prcitem>
<para>Test of the lumbar support</para>
</prcitem>
<prclist2>
<prcitem2><prcitem>
<unlist><unlitem><para><grphcref refid="graphic-25-15-65-991-108-a01"></grphcref></para>
</unlitem>
</unlist>
</prcitem></prcitem2>
<prcitem2><prcitem>
<para>Test lumbar support mounted on the seat</para>
</prcitem>
<prclist3>
<prcitem3><prcitem>
<para>Initial conditions:</para>
</prcitem>
<prclist4>
<prcitem4><prcitem>
<unlist bulltype="ndash"><unlitem><para>Lumbar support inflated (nominal
volume),</para>
</unlitem>
<unlitem><para>Testing lumbar support person sitting on the seat,</para>
</unlitem>
<unlitem><para>Backrest in upright position (ensures sufficient effort
is exerted on the lumbar support).</para>
</unlitem>
</unlist>
</prcitem></prcitem4>
</prclist4>
</prcitem3>
<prcitem3><prcitem>
<para>Test:</para>
</prcitem>
<prclist4>
<prcitem4><prcitem>
<unlist bulltype="ndash"><unlitem><para>Press and hold the button
(on the seat pan spreader).</para>
</unlitem>
<unlitem><para>The lumbar support must deflate.</para>
</unlitem>
</unlist>
</prcitem></prcitem4>
</prclist4>
</prcitem3>
</prclist3>
</prcitem2>
<prcitem2><prcitem>
<para>Test lumbar support uninstalled</para>
</prcitem>
<prclist3>
<prcitem3><prcitem>
<para>Initial conditions:</para>
</prcitem>
<prclist4>
<prcitem4><prcitem>
<unlist bulltype="ndash"><unlitem><para>Lumbar support inflated (nominal
volume).</para>
</unlitem>
</unlist>
</prcitem></prcitem4>
</prclist4>
</prcitem3>
<prcitem3><prcitem>
<para> Test:</para>
</prcitem>
<prclist4>
<prcitem4><prcitem>
<unlist bulltype="ndash"><unlitem><para>Exercise one pressure(25 kg
(55.11 lb) for 1 minute) of the lumbar support with a plate covering
the whole of the contact surface.</para>
</unlitem>
<unlitem><para>The lumbar support must not deflate, meaning that the
pouch is completely sealed.</para>
</unlitem>
<unlitem><para>Press and hold the button (on the seat pan spreader).</para>
</unlitem>
<unlitem><para>The lumbar support must deflate.</para>
</unlitem>
<unlitem><para>Remove the pressure of the lumbar support.</para>
</unlitem>
<unlitem><para>The lumbar support must keep settings.</para>
</unlitem>
</unlist>
</prcitem></prcitem4>
</prclist4>
</prcitem3>
</prclist3>
</prcitem2>
</prclist2>
<graphic chapnbr="25" sectnbr="15" subjnbr="65" func="991" seq="109"
confltr="A" varnbr="01" pgblknbr="1001" chg="u"
key="GRAPHIC-25-15-65-991-109-A01" revdate="20250131"><title>Lumbar
Support Test</title>
<sheet gnbr="graphic25-15-65-991-109-A01-01" sheetnbr="1" imgarea="bp"
chg="u" key="graphic25-15-65-991-109-A01-01" revdate="20250131"></sheet>
</graphic></prcitem1>
</prclist1>
</topic></task>
</pgblk>
