<para>44412-01-00</para>
</entry>
<entry>
<para>56.17 max</para>
</entry>
<entry>
<para>25.48 max</para>
</entry>
</row>
<row>
<entry>
<para>44411-02-00</para>
</entry>
<entry>
<para>56.17 max</para>
</entry>
<entry>
<para>25.48 max</para>
</entry>
</row>
<row>
<entry>
<para>44412-02-00</para>
</entry>
<entry>
<para>56.17 max</para>
</entry>
<entry>
<para>25.48 max</para>
</entry>
</row>
<row>
<entry>
<para>44411-03-00</para>
</entry>
<entry>
<para>53.09 max &plusmn;3%</para>
</entry>
