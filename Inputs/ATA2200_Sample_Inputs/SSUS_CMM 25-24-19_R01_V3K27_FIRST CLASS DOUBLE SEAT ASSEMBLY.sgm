<para>(1,7 N&bull;m)</para>
</entry>
<entry>
<para>7 inch-pounds</para>
<para>(0,8 N&bull;m)</para>
</entry>
<entry>
<para>9 inch-pounds</para>
<para>(1,0 N&bull;m)</para>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<para>10-32</para>
</entry>
<entry>
<para>20 inch-pounds</para>
<para>(2,2 N&bull;m)</para>
</entry>
<entry>
<para>25 inch-pounds</para>
<para>(2,8 N&bull;m)</para>
</entry>
<entry>
<para>12 inch-pounds</para>
<para>(1,3 N&bull;m)</para>
</entry>
<entry>
<para>15 inch-pounds</para>
<para>(1,7 N&bull;m)</para>
</entry>
</row>
<row>
<entry valign="middle" align="center">
