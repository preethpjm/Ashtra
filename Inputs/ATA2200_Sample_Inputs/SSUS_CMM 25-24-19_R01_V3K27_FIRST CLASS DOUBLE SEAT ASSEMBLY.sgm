key="task-25-24-19-99f-017-a01" revdate="20260918">
<title>Abbreviations and Unit Symbols</title>
<topic>
<prclist1>
<prcitem1><prcitem><para><revst>Abbreviations and Unit Symbols used
in this manual are given in Table <refint reftype="ELEMENT"
refid="table-25-24-19-99a-003-a01"></refint>.</para>
<note><para>All weights and measurements are given first in English
standard units followed by the metric equivalent in brackets.</para>
<revend></note>
</prcitem></prcitem1>
<prcitem1><prcitem>
<table chapnbr="25" sectnbr="24" subjnbr="19" func="99A" seq="003"
confltr="A" varnbr="01" pgblknbr="0" id="table-25-24-19-99a-003-a01">
<title><revst>Abbreviations, Acronyms and Unit Symbols<revend></title>
<tgroup cols="2">
<colspec colname="col1">
<colspec colname="col2">
<thead>
<row>
<entry valign="middle" align="center"><?Pub _cellfont Weight="bold">
