</subtask>
<subtask chapnbr="25" sectnbr="24" subjnbr="19" func="94B" seq="006"
confltr="A" varnbr="01" pgblknbr="9000" chg="u"
key="subtask-25-24-19-94b-006-a01" revdate="20080417">
<title>Special Tools</title>
<prclist1>
<prcitem1><prcitem><para>The special tools needed for the seat assembly
are given in <refint reftype="ELEMENT"
refid="table-25-23-24-94b-003-a01"></refint>.</para>
<note><para>Equivalent substitutes may be used for the items listed.</para>
</note>
</prcitem></prcitem1>
<prcitem1><prcitem>
<table chapnbr="25" sectnbr="24" subjnbr="19" func="94B" seq="003"
confltr="A" varnbr="01" pgblknbr="9000" id="table-25-23-24-94b-003-a01">
<title>Special Tools</title>
<tgroup cols="3">
<colspec colname="col1">
<colspec colname="col2">
<colspec colname="col3">
<thead>
<row>
<entry valign="middle" align="center"><?Pub _cellfont Weight="bold">
