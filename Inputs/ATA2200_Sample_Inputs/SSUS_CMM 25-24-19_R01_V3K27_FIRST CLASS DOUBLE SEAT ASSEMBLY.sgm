</entry>
<entry valign="middle" align="center"><?Pub _cellfont Weight="bold">
<para>Minimum Tension </para>
</entry>
<entry valign="middle" align="center"><?Pub _cellfont Weight="bold">
<para>Maximum Tension</para>
</entry>
<entry valign="middle" align="center"><?Pub _cellfont Weight="bold">
<para>Minimum Shear</para>
</entry>
<entry valign="middle" align="center"><?Pub _cellfont Weight="bold">
<para>Maximum Shear</para>
</entry>
</row>
</thead>
