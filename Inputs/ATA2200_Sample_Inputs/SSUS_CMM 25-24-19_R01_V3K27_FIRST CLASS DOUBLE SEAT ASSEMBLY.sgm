<para>(4,5 N&bull;m)</para>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<para>5/16-24</para>
</entry>
<entry>
<para>100 inch-pounds</para>
<para>(11,2 N&bull;m)</para>
</entry>
<entry>
<para>140 inch-pounds</para>
<para>(15,7 N&bull;m)</para>
</entry>
<entry>
