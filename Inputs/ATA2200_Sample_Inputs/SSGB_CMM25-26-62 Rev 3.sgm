<entry morerows="0" rotate="0" valign="top">
<para><?Pub _font Weight="bold">PRODUCT<?Pub /_font></para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para><?Pub _font Weight="bold">PERIODIC CHECK (MONTHS)<?Pub /_font></para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para><?Pub _font Weight="bold">ACTION<?Pub /_font></para>
</entry>
</row>
<row>
<entry morerows="0" rotate="0" valign="top">
<para>Privacy Screen Actuators</para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para>24 Months</para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para>Return to Safran Seats GB Limited</para>
</entry>
</row>
</tbody>
</tgroup>
</table>
</prcitem></prcitem3>
</prclist3>
</prcitem2>
</prclist2>
