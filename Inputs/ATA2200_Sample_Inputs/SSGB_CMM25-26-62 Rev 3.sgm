<prclist3>
<prcitem3><prcitem>
<table chapnbr="25" sectnbr="26" subjnbr="62" func="99A" seq="011"
confltr="A" varnbr="01" pgblknbr="4000" id="table-25-26-62-99a-011-a01"><?Pub Lcl
_tabindent="1">
<title>Loose Covers Identification and Location</title>
<tgroup cols="4" align="left" charoff="50" char="">
<?PubTbl tgroup dispwid="12.00in"?>
<colspec colname="colspec0" colwidth="1.34*">
<colspec colname="col1" colwidth="1.34*">
<colspec colname="col2" colwidth="1.21*">
<colspec colname="colspec2" colwidth="1.17*">
<thead valign="bottom">
<row>
<entry morerows="0" rotate="0" valign="middle" align="center">
<para>IPL FIGURE AND ITEM NUMBER</para>
</entry>
<entry morerows="0" rotate="0" valign="middle" align="center">
<para>REFERENCE AND/OR PART NUMBER</para>
</entry>
<entry morerows="0" rotate="0" valign="middle" align="center">
<para>DESCRIPTION AND/OR SPECIFICATION</para>
</entry>
<entry morerows="0" rotate="0" valign="middle" align="center">
<para>SUPPLIER CAGE CODE OR NAME AND ADDRESS</para>
</entry>
</row>
</thead>
<tbody valign="top">
<row>
<entry morerows="0" rotate="0" valign="top">
<para>(Part of Folding Armrest cover, 18-50)</para>
<para>5-10, 6-10,</para>
<para>(Part of closeout, 6-355)</para>
<para>12-65</para>
<para>(Part of Armrest Support, 13-640)</para>
<para>(Part of Pull Tab Assembly, 21-55)</para>
</entry>
<entry morerows="0" rotate="0" valign="top" align="left">
<para>DL179</para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para>Leather, Deep Purple 44629</para>
</entry>
<entry morerows="0" rotate="0" valign="top" align="left">
<para>VK0624</para>
</entry>
</row>
<row>
<entry morerows="0" rotate="0" valign="top">
<para>(Part of Trim Panel Assembly, 17-35)</para>
<para>(Part of Trim Panel Assembly, 17-365)</para>
