<task chapnbr="25" sectnbr="26" subjnbr="62" func="820" seq="803"
confltr="A" varnbr="01" pgblknbr="8000" chg="u"
key="task-25-26-62-820-803-a01" revdate="20260318">
<title>Suite Door Assembly Removal and Installation Procedure</title>
<topic>
<title>Reason for the Job:</title>
<prclist1><?Pub Dtl>
<prcitem1><prcitem><para>To remove and install the suite door.</para>
</prcitem></prcitem1>
</prclist1>
</topic>
<topic>
<title>Job Set-up Information:</title>
<prclist1><?Pub Dtl>
<prcitem1><prcitem><para>Tools, Fixtures and Equipment:</para></prcitem>
<prclist2>
<prcitem2><prcitem><para>Not Applicable.</para></prcitem></prcitem2>
</prclist2>
</prcitem1>
<prcitem1><prcitem><para>Consumables:</para>
<note><para>Refer to <refint reftype="ELEMENT" refid="vendlist-25-26-62"></refint> for
vendor addresses.</para></note>
</prcitem>
<prclist2>
<prcitem2><prcitem>
<table chapnbr="25" sectnbr="26" subjnbr="62" func="99A" seq="075"
confltr="A" varnbr="01" pgblknbr="8000" id="table-25-26-62-99a-075-a01"><?Pub Lcl
_tabindent="1">
<title>Consumables</title>
<tgroup cols="3" align="left" charoff="50" char="">
<?PubTbl tgroup dispwid="12.00in"?>
<colspec colname="col2" colwidth="1.18*">
<colspec colname="col3" colwidth="1.43*">
<colspec colname="col4" colwidth="1.39*">
<thead valign="bottom">
<row>
<entry morerows="0" rotate="0" valign="top" align="center">
<para>REFERENCE AND/OR PART NUMBER</para>
</entry>
<entry morerows="0" rotate="0" valign="top" align="center">
<para>DESCRIPTION AND/OR SPECIFICATION</para>
</entry>
<entry morerows="0" rotate="0" valign="top" align="center">
<para>SUPPLIER CODE OR NAME AND ADDRESS</para>
</entry>
</row>
</thead>
<tbody valign="top">
<row>
<entry morerows="0" rotate="0" valign="top">
<para>Loctite 222</para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para>Thread Locking Compound</para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para>VU0406</para>
</entry>
</row>
<row>
<entry morerows="0" rotate="0" valign="top">
<para>Loctite 7649</para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para>Activator</para>
</entry>
<entry morerows="0" rotate="0" valign="top">
<para>VU0406</para>
</entry>
</row>
</tbody>
</tgroup>
</table>
</prcitem></prcitem2>
</prclist2>
</prcitem1>
</prclist1>
</topic>
<topic>
<title>Job Set-up:</title>
<prclist1><?Pub Dtl>
<prcitem1><prcitem><para>Not Applicable.</para></prcitem></prcitem1>
</prclist1>
</topic>
<topic>
<title>Procedure:</title>
<prclist1><?Pub Dtl>
<prcitem1><prcitem><para>Removal of the sliding door assembly:</para>
</prcitem>
<prclist2>
<prcitem2><prcitem><para>Remove the canopy installations (5-135, 6-135)
from the furniture assembly.</para>
<note><para>Refer to Fig 28 IPL for the Canopy Installation details.</para>
</note>
</prcitem></prcitem2>
<prcitem2><prcitem><para>Get access to the sliding door assembly on
the suite door assembly.</para></prcitem></prcitem2>
<prcitem2><prcitem><para>Remove the bonded part collar (16-290) from
the sliding door assembly.</para></prcitem></prcitem2>
<prcitem2><prcitem><para>Remove four countersunk head screws (16-170,
16-175) from the top of the door panel assembly (16-325).</para>
</prcitem></prcitem2>
<prcitem2><prcitem><para>Disengage the spigot block assembly (16-165)
from the carriage block assembly (16-100) to release the EPF button
(16-320).</para></prcitem></prcitem2>
<prcitem2><prcitem><para>Remove two set screws (16-180) and the EPF
button (16-320).</para></prcitem></prcitem2>
<prcitem2><prcitem><para>Lift and remove the sliding door assembly
from the furniture assembly.</para></prcitem></prcitem2>
</prclist2>
</prcitem1>
<prcitem1><prcitem><para>Installation of the sliding door assembly:</para>
</prcitem>
<prclist2>
<prcitem2><prcitem><para>Lift and attach the sliding door assembly
to the furniture assembly.</para></prcitem></prcitem2>
<prcitem2><prcitem><para>Push and hold the EPF button (16-320) on
the outside of the door to re-fit the suite door.</para>
<note><para>NOTE: If necessary, rotate the EPF button (16-320) slightly.</para>
</note>
</prcitem></prcitem2>
<prcitem2><prcitem><para>Attach the EPF button (16-320) and two set
screws (16-180).</para></prcitem></prcitem2>
<prcitem2><prcitem><para>Engage the spigot block assembly (16-165)
to the carriage block assembly (16-100), while the EPF button (16-320)
is pushed.</para>
<note><para>Make sure that the carriage block assembly (16-100) is
fully engaged.</para></note>
</prcitem></prcitem2>
<prcitem2><prcitem><para>Install the EPF button (16-320).</para>
</prcitem></prcitem2>
<prcitem2><prcitem><para>Make sure that the EPF button (16-320) engaged
correctly and stays in the engaged position.</para></prcitem></prcitem2>
<prcitem2><prcitem><para>Attach four countersunk head screws (16-170,
16-175) to the top of the door panel assembly (16- 325).</para>
</prcitem></prcitem2>
<prcitem2><prcitem>
<warning><para>WHEN ADHESIVES ARE USED, OBEY ALL PROCEDURE INSTRUCTIONS
AND HEALTH AND SAFETY WARNINGS SUPPLIED BY THE MANUFACTURER. THIS
WILL HELP PREVENT INJURY.</para></warning>
<para>Apply thread locking compound Loctite 222 (with activator 7649)
to threads of the collar (16-290). Attach the collar (16-290) to the
sliding door assembly.</para>
<note><para>Adhesive cure time is 3 hours at 22 deg C (72 deg F).</para>
</note>
</prcitem></prcitem2>
<prcitem2><prcitem><para>Attach the canopy installation (5-135, 6-135)
from the furniture assembly.</para>
<note><para>Refer to Fig 28 IPL for the Canopy Installation details.</para>
</note>
</prcitem></prcitem2>
</prclist2>
</prcitem1>
<prcitem1><prcitem></prcitem><graphic chapnbr="25" sectnbr="26"
subjnbr="62" func="820" seq="002" confltr="A" varnbr="01"
pgblknbr="8000" chg="u" key="graphic-25-26-62-820-002-a01"
revdate="20260318">
<title>SUITE DOOR ASSEMBLY REMOVAL AND INSTALLATION</title>
<sheet gnbr="ent252662-FC-8002-01-00.cgm" sheetnbr="1" chg="u"
key="sheet-25-26-62-820-001-a01-6" revdate="20260318"></sheet>
<sheet gnbr="ent252662-FC-8002-02-00.cgm" sheetnbr="2" chg="u"
key="sheet-25-26-62-820-001-a01-7" revdate="20260318"></sheet>
<sheet gnbr="ent252662-FC-8002-03-00.cgm" sheetnbr="3" chg="u"
key="sheet-25-26-62-820-001-a01-8" revdate="20260318"></sheet>
<sheet gnbr="ent252662-FC-8002-04-00.cgm" sheetnbr="4" chg="u"
key="sheet-25-26-62-820-001-a01-9" revdate="20260318"></sheet>
<sheet gnbr="ent252662-FC-8002-05-00.cgm" sheetnbr="5" chg="u"
key="sheet-25-26-62-820-001-a01-10" revdate="20260318"></sheet>
</graphic></prcitem1>
</prclist1>
</topic>
</task>
</pgblk>
