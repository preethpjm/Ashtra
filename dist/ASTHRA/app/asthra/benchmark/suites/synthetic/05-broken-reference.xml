  <content>
    <procedure>
      <preliminaryRqmts>
        <reqSupportEquips><supportEquip><name>Torque wrench</name><toolRef>T-0042</toolRef></supportEquip></reqSupportEquips>
        <reqSupplies><supply><name>Hydraulic fluid</name></supply></reqSupplies>
        <warning><para>Make sure the aircraft is safe for maintenance. Refer to <internalRef internalRefId="stp-9999"/>.</para></warning>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep id="stp-0001"><para>Remove the access panel.</para></proceduralStep>
        <proceduralStep id="stp-0002">
          <caution><para>Do not damage the seal.</para></caution>
          <para>Disconnect the hydraulic line.</para>
          <proceduralStep><para>Cap the open line.</para></proceduralStep>
        </proceduralStep>
      </mainProcedure>
      <closeRqmts><para>Install the access panel.</para></closeRqmts>
    </procedure>
  </content>
