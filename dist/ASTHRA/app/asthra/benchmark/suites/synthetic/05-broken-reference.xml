      <dmIdent>
        <dmCode modelIdentCode="ASTHRA" systemDiffCode="A" systemCode="32" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="520" infoCodeVariant="A" itemLocationCode="A"/>
        <issueInfo issueNumber="001" inWork="00"/>
