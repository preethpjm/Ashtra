  <content>
    <warningsAndCautions><warning id="wrn-0001"><warningAndCautionPara>THE SPRING IS COMPRESSED. USE THE SPRING COMPRESSOR TO RELEASE IT SLOWLY. IF YOU DO NOT, THE PARTS CAN MOVE SUDDENLY AND CAUSE INJURY.</warningAndCautionPara></warning><caution id="cau-0001"><warningAndCautionPara>DO NOT USE A SHARP TOOL TO REMOVE THE PACKINGS. A SCRATCH ON THE PISTON ROD CAN CAUSE A LEAK.</warningAndCautionPara></caution></warningsAndCautions>
    <procedure>
      <commonInfo><title>Job description</title><para>This procedure gives the instructions to disassemble the actuator.</para></commonInfo>
      <preliminaryRqmts><reqCondGroup><noConds/></reqCondGroup><reqPersons><personnel numRequired="1"><personCategory personCategoryCode="Shop technician"/><personSkill skillLevelCode="sk02"/><estimatedTime unitOfMeasure="h">0.75</estimatedTime></personnel></reqPersons><reqSupportEquips><supportEquipDescrGroup><supportEquipDescr id="seq-adt-7100-01"><name>Spring compressor</name><identNumber><manufacturerCode>ZZD01</manufacturerCode><partAndSerialNumber><partNumber>ADT-7100-01</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr><supportEquipDescr id="seq-adt-7100-02"><name>Holding fixture, rod end</name><identNumber><manufacturerCode>ZZD01</manufacturerCode><partAndSerialNumber><partNumber>ADT-7100-02</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="EA">1</reqQuantity></supportEquipDescr></supportEquipDescrGroup></reqSupportEquips><reqSupplies><supplyDescrGroup><supplyDescr id="sup-tt-i-735"><name>Isopropyl alcohol</name><identNumber><manufacturerCode>81348</manufacturerCode><partAndSerialNumber><partNumber>TT-I-735</partNumber></partAndSerialNumber></identNumber><reqQuantity unitOfMeasure="ml">50</reqQuantity></supplyDescr></supplyDescrGroup></reqSupplies><reqSpares><noSpares/></reqSpares><reqSafety><safetyRqmts><warning><warningAndCautionPara>THE SPRING IS COMPRESSED. USE THE SPRING COMPRESSOR TO RELEASE IT SLOWLY. IF YOU DO NOT, THE PARTS CAN MOVE SUDDENLY AND CAUSE INJURY.</warningAndCautionPara></warning></safetyRqmts></reqSafety></preliminaryRqmts>
      <mainProcedure><proceduralStep><title>Remove the rod end</title><proceduralStep><para>Install the actuator in the holding fixture, <internalRef internalRefId="seq-adt-7100-02" internalRefTargetType="irtt05"/>.</para></proceduralStep><proceduralStep><para>Remove the nut (40) from the piston rod (20).</para></proceduralStep><proceduralStep><para>Remove the rod end (30). Refer to the illustrated parts data (<dmRef><dmRefIdent><dmCode modelIdentCode="ASTDEMO" systemDiffCode="A" systemCode="25" subSystemCode="2" subSubSystemCode="1" assyCode="71" disassyCode="00" disassyCodeVariant="A" infoCode="941" infoCodeVariant="A" itemLocationCode="C"/></dmRefIdent></dmRef>).</para></proceduralStep></proceduralStep><proceduralStep warningRefs="wrn-0001"><title>Remove the spring and the lock mechanism</title><proceduralStep><para>Install the spring compressor, <internalRef internalRefId="seq-adt-7100-01" internalRefTargetType="irtt05"/> and compress the spring (50 or 50A).</para></proceduralStep><proceduralStep><para>Remove the four screws (90) and the four washers (100). Remove the lock mechanism (60).</para></proceduralStep><proceduralStep><para>Slowly release the spring compressor. Remove the spring and the piston rod (20) from the housing (10).</para></proceduralStep></proceduralStep><proceduralStep cautionRefs="cau-0001"><title>Remove the packings</title><proceduralStep><para>Remove the two packings (110) from the piston rod (20). Discard the packings.</para></proceduralStep><proceduralStep><para>Clean all the parts with isopropyl alcohol, <internalRef internalRefId="sup-tt-i-735" internalRefTargetType="irtt04"/>. Let them dry.</para></proceduralStep></proceduralStep></mainProcedure>
      <closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
    </procedure>
  </content>
