<itemdata itemnbr="1A" attach="0" illusind="0" indent="0" delitem="0"><pnr>RA-7100-02</pnr><iplnom><nom><kwd>ACTUATOR ASSY</kwd><adt>RECLINE</adt></nom><msc>POST SB 25-0012</msc></iplnom><effcode>B</effcode><upa>RF</upa></itemdata>
